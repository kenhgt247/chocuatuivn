
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCTIONS HỖ TRỢ ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    // Người dùng uid đã chặn người đang thao tác chưa (danh sách chặn nằm trong hồ sơ riêng)
    function blockedBy(uid) {
      return request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('blockedIds', []);
    }

    // Kiểm tra xem người dùng có đang cố gắng thay đổi các trường nhạy cảm không
    function isNotChangingSensitiveUserFields() {
      let sensitiveFields = ['role', 'walletBalance', 'subscriptionTier', 'subscriptionExpires', 'status'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // --- RULES CHO TỪNG COLLECTION ---

    // Bảng users có email, SĐT, địa chỉ, tọa độ: chỉ chủ tài khoản và admin đọc.
    // Người khác xem tên/ảnh/khu vực qua publicProfiles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Khi tạo tài khoản mới
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'user' 
        && request.resource.data.walletBalance == 0;
      
      // Khi cập nhật hồ sơ
      allow update: if isAdmin() || (isOwner(userId) && isNotChangingSensitiveUserFields());
    }

    match /listings/{listingId} {
      // Ai cũng xem được tin cộng đồng. Tin rao vặt cũ (có SĐT, địa chỉ người bán)
      // chỉ chủ tin và admin xem.
      allow read: if resource.data.isCommunityFree == true
        || (isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin()));
      
      // Chỉ nhận tin cộng đồng miễn phí, luôn ở trạng thái chờ duyệt.
      // (Rao vặt đã lưu trữ: người dùng không còn tạo được tin rao vặt/VIP
      //  và không thể tự gắn trạng thái "approved".)
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && getUserData().get('status', 'active') != 'banned'
        && (
          isAdmin() ||
          (
            request.resource.data.communityKind in ['gift','borrow','help','repair'] &&
            request.resource.data.isCommunityFree == true &&
            request.resource.data.price == 0 &&
            request.resource.data.tier == 'free' &&
            request.resource.data.status == 'pending'
          )
        );

      // Admin sửa được mọi thứ. Chủ tin chỉ được đánh dấu "đã xong" (sold)
      // hoặc ẩn tin (hidden); không sửa nội dung tin đã được duyệt.
      // Gia hạn: tin hết hạn (sau 30 ngày) được chủ tin cho hiện lại, nội dung không đổi.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['sold','hidden']) ||
          (resource.data.status == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','renewedAt'])
            && request.resource.data.status == 'approved'
            && request.resource.data.renewedAt == request.time) ||
          // Sửa nội dung: tin quay về chờ kiểm tra lại (máy tự duyệt lại)
          (resource.data.status in ['approved','pending','rejected']
            && resource.data.isCommunityFree == true
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title','description','meetPlace','images','thumbs','keywords','status','editedAt','pickupTimes','pickupNote','quantity'])
            && request.resource.data.status == 'pending'
            && request.resource.data.editedAt == request.time
            && request.resource.data.title is string && request.resource.data.title.size() <= 90
            && request.resource.data.images.size() <= 4)
        )
      );

      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }


    // Chợ Của Tui 2.0: yêu cầu riêng tư, không có thanh toán.
    match /publicProfiles/{uid} {
      // sharedCount/receivedCount do máy chủ tính (functions/diemUyTin); người dùng không tự sửa.
      function countersKept() {
        return resource == null
          ? !('sharedCount' in request.resource.data) && !('receivedCount' in request.resource.data) && !('sharedByKind' in request.resource.data)
          : request.resource.data.get('sharedCount', 0) == resource.data.get('sharedCount', 0)
            && request.resource.data.get('receivedCount', 0) == resource.data.get('receivedCount', 0)
            && request.resource.data.get('sharedByKind', {}) == resource.data.get('sharedByKind', {});
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','avatar','location','joinedAt','updatedAt','areaCode','sharedCount','receivedCount','sharedByKind'])
          && (isAdmin() || countersKept())
          && d.name is string && d.name.size() <= 60
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 600))
          && (!('location' in d) || (d.location is string && d.location.size() <= 100));
      }
      allow read: if true;
      allow create, update: if (isOwner(uid) || isAdmin()) && validProfile();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /communityRequests/{requestId} {
      function isParticipant() {
        return isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.requesterId == request.auth.uid
        );
      }
      function sourceListing() {
        return get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data;
      }
      allow get, list: if isParticipant() || isAdmin();
      allow create: if isSignedIn()
        && getUserData().get('status', 'active') != 'banned'
        && request.resource.data.keys().hasOnly([
          'listingId','listingTitle','kind','intent','ownerId','requesterId',
          'message','status','createdAt','updatedAt'
        ])
        && (!('intent' in request.resource.data) ||
            request.resource.data.intent == sourceListing().get('communityIntent', 'have'))
        && request.resource.data.keys().hasAll([
          'listingId','listingTitle','kind','ownerId','requesterId',
          'message','status','createdAt','updatedAt'
        ])
        && requestId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.kind in ['gift','borrow','help','repair']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && sourceListing().sellerId == request.resource.data.ownerId
        && sourceListing().communityKind == request.resource.data.kind
        && sourceListing().status == 'approved'
        && sourceListing().isCommunityFree == true
        && sourceListing().price == 0
        && !blockedBy(request.resource.data.ownerId);
      // Hoàn thành phải do hai bên: người trao báo đã xong, người nhận xác nhận.
      // Tin "Tôi có": chủ tin là người trao. Tin "Tôi cần": người gửi yêu cầu là người trao.
      function giverId() {
        return resource.data.get('intent', 'have') == 'need' ? resource.data.requesterId : resource.data.ownerId;
      }
      function receiverId() {
        return resource.data.get('intent', 'have') == 'need' ? resource.data.ownerId : resource.data.requesterId;
      }
      function moving(from, to) {
        return resource.data.status == from && request.resource.data.status == to;
      }
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (moving('requested', 'accepted') && request.auth.uid == resource.data.ownerId) ||
          (moving('requested', 'declined') && request.auth.uid == resource.data.ownerId) ||
          (moving('requested', 'cancelled') && request.auth.uid == resource.data.requesterId) ||
          (moving('accepted', 'cancelled')) ||
          (moving('accepted', 'handed_over') && request.auth.uid == giverId()) ||
          (moving('handed_over', 'completed') && resource.data.kind != 'borrow' && request.auth.uid == receiverId()) ||
          (moving('handed_over', 'returned') && resource.data.kind == 'borrow' && request.auth.uid == receiverId()) ||
          (moving('returned', 'completed') && resource.data.kind == 'borrow' && request.auth.uid == giverId())
        );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /chats/{chatId} {
      // Chỉ những người trong cuộc hội thoại mới được xem và gửi tin
      allow read, delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      function otherOf(ids) {
        return ids[0] == request.auth.uid ? ids[1] : ids[0];
      }
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && !blockedBy(otherOf(request.resource.data.participantIds));
      // Người trong cuộc chat không được tự thêm/bớt người khác; bị chặn thì không nhắn được.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && !blockedBy(otherOf(resource.data.participantIds));
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /transactions/{txId} {
      // Người dùng chỉ được tạo yêu cầu nạp tiền với trạng thái 'pending'
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
        
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Chỉ Admin mới được duyệt (thay đổi status) giao dịch
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid);
      // Chống spam: người dùng chỉ được báo cho người đang có chung một yêu cầu
      // hoặc một phòng chat với mình; nội dung ngắn, link nội bộ. Admin gửi tự do.
      allow create: if isAdmin() || (isSignedIn() && validUserNotification());
      function validUserNotification() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId','title','message','type','link','read','createdAt','requestId','chatId','image'])
          && d.userId is string && d.userId != request.auth.uid
          && d.title is string && d.title.size() <= 120
          && d.message is string && d.message.size() <= 300
          && d.read == false
          && !blockedBy(d.userId)
          && (!('link' in d) || (d.link is string && d.link.matches('^/[^/].*')))
          && (
            ('requestId' in d && sharedRequest(d.requestId, d.userId)) ||
            ('chatId' in d && sharedChat(d.chatId, d.userId))
          );
      }
      function sharedRequest(id, other) {
        let r = get(/databases/$(database)/documents/communityRequests/$(id)).data;
        return [r.ownerId, r.requesterId].hasAll([request.auth.uid, other]);
      }
      function sharedChat(id, other) {
        let c = get(/databases/$(database)/documents/chats/$(id)).data;
        return c.participantIds.hasAll([request.auth.uid, other]);
      }
    }

    // Lời cảm ơn sau khi trao xong: chỉ người nhận của yêu cầu đã hoàn thành viết, mỗi yêu cầu một lời.
    match /thanks/{requestId} {
      function req() {
        return get(/databases/$(database)/documents/communityRequests/$(requestId)).data;
      }
      function receiverOfReq() {
        return req().get('intent', 'have') == 'need' ? req().ownerId : req().requesterId;
      }
      function giverOfReq() {
        return req().get('intent', 'have') == 'need' ? req().requesterId : req().ownerId;
      }
      allow read: if true;
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/communityRequests/$(requestId))
        && req().status == 'completed'
        && request.auth.uid == receiverOfReq()
        && request.resource.data.keys().hasOnly(['giverId','receiverId','receiverName','receiverAvatar','listingId','listingTitle','kind','message','photo','createdAt'])
        && request.resource.data.receiverId == request.auth.uid
        && request.resource.data.giverId == giverOfReq()
        && request.resource.data.listingId == req().listingId
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.receiverName is string && request.resource.data.receiverName.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.receiverId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // "Vừa trao xong": máy chủ ghi, ai cũng đọc được (không có tên người nhận)
    match /traoXong/{listingId} {
      allow read: if true;
      allow write: if false;
    }
    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /favorites/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
