rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chỉ nhận ảnh, tối đa 5 MB
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Ảnh tin đăng: ai cũng xem được, chỉ chủ thư mục được tải lên/xoá
    match /listings/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Ảnh đại diện và ảnh gửi trong tin nhắn: users/<uid>/...
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
